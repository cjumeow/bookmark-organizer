{
  "name": "bookmark-organizer-mcp",
  "version": "0.1.1",
  "description": "MCP server that gives a coding agent tools to read and reorganize Chrome bookmarks.",
  "license": "MIT",
  "keywords": [
    "mcp",
    "chrome",
    "bookmarks",
    "claude-code"
  ],
  "homepage": "https://github.com/cjumeow/bookmark-organizer#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cjumeow/bookmark-organizer.git",
    "directory": "mcp-server"
  },
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "files": [
    "dist/index.js",
    "dist/index.js.map",
    "LICENSE",
    "README.md"
  ],
  "bin": {
    "bookmark-organizer-mcp": "dist/index.js"
  },
  "scripts": {
    "prepack": "node -e \"for (const f of ['LICENSE', 'README.md']) require('node:fs').copyFileSync('../' + f, f)\"",
    "build": "node build.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "ws": "8.22.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@bookmark-organizer/shared": "*",
    "@types/ws": "8.18.2"
  }
}
