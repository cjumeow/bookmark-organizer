{
  "manifest_version": 3,
  "name": "Bookmark Organizer",
  "version": "0.1.1",
  "description": "Lets a coding agent reorganize your bookmarks through a local MCP server.",
  "minimum_chrome_version": "134",
  "key": "",
  "permissions": ["bookmarks", "alarms"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  }
}
